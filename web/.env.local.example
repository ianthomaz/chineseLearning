# Se apagaste o .env.local, recria assim:
#   node scripts/sync-env-from-credentials.mjs
# (regenera web/.env.local a partir de local/credentials/credentials.json)
#
# Token: o mesmo Bearer serve para API local (Docker) e para https://llm.webplace.cc
LLM_API_TOKEN=cola-o-token-do-servidor-da-api
#
# URL da API (opcional — se omitires, usa web/.env = http://127.0.0.1:28471).
# Escolhe UMA consoante o que tens a correr; não precisas de mudar código, só esta linha:
#
#   LLM_API_URL=http://127.0.0.1:28471
#   LLM_API_URL=https://llm.webplace.cc
#
# Tutor + POST /api/chat: precisas de Node (não basta export estático):
#   ./start.sh --local   ou   npm run deploy:local:with-api
# Só HTML estático: npm run deploy:local  ou  ./start.sh --webplace

# Site at root — dev URL: http://127.0.0.1:34827/
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2YMPSSQJND

# --- Google Auth (OAuth chinese-learnin) — docs/05_autenticacao.md
# NEXTAUTH_URL=http://127.0.0.1:34827
# NEXT_PUBLIC_GOOGLE_CLIENT_ID = mesmo valor que GOOGLE_CLIENT_ID (One Tap)
# GCP Console: add http://127.0.0.1:34827 and :34902 origins + redirect URIs (see docs/20)

# --- Dashboard / backoffice / curator (admin)
# NEXT_PUBLIC_ADMIN_EMAIL=ianthomaz@gmail.com

# --- Content source (docs/07_conteudo_dados.md)
#   npm run seed:content
# CONTENT_SOURCE=json
