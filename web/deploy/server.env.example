# Template: copy to deploy/server.env (gitignored) and fill in.
# Site: https://learnchinese.today/ (no basePath)
#
# Generate from credentials: node scripts/sync-env-from-credentials.mjs
#
# Used by:
# - `./start.sh --prod` / `--prepare`
# - `./start.sh --prod --upload` / `npm run deploy:prod`
# - `npm run remote:handshake`

# --- Process / nginx (itcsVM3 shared host)
HOSTNAME=127.0.0.1
PORT=34827

# --- Site
NEXT_PUBLIC_BASE_PATH=
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2YMPSSQJND

# --- LLM (reachable from the Node host)
LLM_API_URL=https://llm.webplace.cc
LLM_API_TOKEN=

# --- APP Hanzi Memorize library API (docs/09_roadmap_integracoes.md)
# APP_LIBRARY_TOKEN=

# Optional LLM tutor model overrides — see featureLLM docs/EDU_API_CONTRACT.md
# LLM_EDU_CHAT_MODEL=smart
# LLM_EDU_CHAT_MODEL_RETRY=smart
# RAG_SOURCES_PATH=

# --- Google Auth (OAuth chinese-learnin) — docs/05_autenticacao.md
AUTH_TRUST_HOST=true
NEXTAUTH_URL=https://learnchinese.today
AUTH_URL=https://learnchinese.today
NEXTAUTH_SECRET=
AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Admin allow-list is build-time: NEXT_PUBLIC_ADMIN_EMAIL in web/.env.local
