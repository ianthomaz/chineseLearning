# learnchinese.today — vhost partilhado (nginx no host itcsVM3, Cloudflare proxied).
# Copiar para /etc/nginx/conf.d/learnchinese.today.conf
# Node: 127.0.0.1:34827 (server.env HOSTNAME=127.0.0.1 PORT=34827)
#
# Depois: sudo nginx -t && sudo systemctl reload nginx
# Ver web/deploy/README.md para TLS (Cloudflare origin cert ou certbot).

# --- HTTP :80 — apex (redirect www handled below) ---
server {
    listen 80;
    listen [::]:80;
    server_name learnchinese.today;

    location / {
        proxy_pass http://127.0.0.1:34827;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}

# --- HTTP :80 — www → apex ---
server {
    listen 80;
    listen [::]:80;
    server_name www.learnchinese.today;
    return 301 https://learnchinese.today$request_uri;
}

# =============================================================================
# HTTPS :443 — escolhe UMA opção (descomenta o bloco correspondente)
# Cloudflare dashboard: SSL/TLS → Full (strict) quando usares origin cert (Opção A)
# =============================================================================

