# Environment — local secrets & paths (do not commit secrets)
# Site: learnchinese.today. Full prod template: deploy/server.env.example

DATABASE_URL="file:../data/phrase-game.sqlite"

# Empty = site served at / (not under a subpath)
NEXT_PUBLIC_BASE_PATH=

# Google Analytics (stream LearnChineseCOM). Loaded only after cookie consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2YMPSSQJND

# Optional: SITE_DB=/absolute/path/to/phrase-game.sqlite
# Optional: CONTENT_SOURCE=db

# OAuth + auth secrets: node scripts/sync-env-from-credentials.mjs (from local/credentials/credentials.json)
