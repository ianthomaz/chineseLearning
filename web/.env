# Valores partilhados no repo (sem segredos). Next.js carrega isto em todos os ambientes.
# Sobrescreve em .env.local (gitignored) — ver .env.local.example.
#
# Site: learnchinese.today (sem basePath). Regenerar secrets: node scripts/sync-env-from-credentials.mjs

LLM_API_URL=http://127.0.0.1:28471
DATABASE_URL="file:../data/phrase-game.sqlite"

# Empty = site at /. Build-time; see credentials.json → deployment.base_path
NEXT_PUBLIC_BASE_PATH=

# GA4 stream LearnChineseTODAY — loaded only after cookie consent
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-2YMPSSQJND
