  "taskDemo": {
    "pdfPage": 61,
    "sceneZh": "大龙班里来了一位漂亮的新同学，她的名字叫茉莉。下了课，茉莉跟大龙聊天。",
    "sceneEn": "A beautiful new classmate named Moli came to Dalong's class. Moli is chatting with Dalong after class.",
    "lines": [
      {
        "speaker": "茉莉",
        "hanzi": "你汉语说得很流利。"
      },
      {
        "speaker": "大龙",
        "hanzi": "谢谢。"
      },
      {
        "speaker": "茉莉",
        "hanzi": "你学了多长时间了？"
      },
      {
        "speaker": "大龙",
        "hanzi": "我学了三个月了。"
      },
      {
        "speaker": "茉莉",
        "hanzi": "什么？！才三个月？你学的时间比我短，可是你说得比我好。"
      },
      {
        "speaker": "大龙",
        "hanzi": "哪里哪里，你认识的汉字比我多。你以前在哪儿学习？"
      },
      {
        "speaker": "茉莉",
        "hanzi": "在意大利。我是大学三年级的学生。"
      },
      {
        "speaker": "大龙",
        "hanzi": "你是中文系的学生吗？"
      },
      {
        "speaker": "茉莉",
        "hanzi": "不是，我的专业是国际贸易。你呢？"
      },
      {
        "speaker": "大龙",
        "hanzi": "我学习法律。大学毕业以后，我才开始学习汉语。"
      },
      {
        "speaker": "茉莉",
        "hanzi": "看来，还是在中国学习汉语更好。"
      }
    ]
  },
  "grammar": [
    {
      "id": "duration-complement",
      "titleZh": "时量补语",
      "titleEn": "Complement of duration",
      "patternZh": "主语＋（动词＋宾语）＋动词＋了＋时量补语＋了",
      "patternEn": "Subject + (verb + object) + verb + 了 + complement of duration + 了",
      "examples": [
        {
          "hanzi": "我已经学了三个月了。",
          "pinyin": "Wǒ yǐjīng xuéle sān ge yuè le."
        },
        {
          "hanzi": "我学汉语学了一年多了。",
          "pinyin": "Wǒ xué Hànyǔ xuéle yì nián duō le."
        },
        {
          "hanzi": "我学汉语学了三个月了。",
          "note": "ongoing (final 了)"
        },
        {
          "hanzi": "我学汉语学了三个月。",
          "note": "finished (no final 了)"
        }
      ]
    },
    {
      "id": "bi-comparison",
      "titleZh": "用“比”表示比较",
      "titleEn": "Use “比” to indicate comparison",
      "patternZh": "A比B＋不同",
      "patternEn": "A 比 B + difference",
      "examples": [
        {
          "hanzi": "他比我聪明。"
        },
        {
          "hanzi": "大龙汉语说得比茉莉好。"
        },
        {
          "hanzi": "她现在比以前更努力。"
        },
        {
          "hanzi": "她学习时间比我还长。"
        },
        {
          "hanzi": "我不比他聪明。"
        },
        {
          "hanzi": "大龙汉字写得不比茉莉好。"
        }
      ],
      "notes": [
        "Do not use 很/非常 after 比; use 更 or 还 instead.",
        "Negation can use 不比."
      ]
    }
  ],
