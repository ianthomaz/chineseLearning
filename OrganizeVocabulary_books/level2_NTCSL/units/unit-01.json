  "taskDemo": {
    "pdfPage": 24,
    "sceneZh": "张丽的爸爸妈妈和大龙在房间里聊天。",
    "sceneEn": "Zhang Li's parents are chatting with Dalong in the room.",
    "lines": [
      {
        "speaker": "张丽妈妈",
        "hanzi": "天阴了！"
      },
      {
        "speaker": "张丽爸爸",
        "hanzi": "天气预报说今天是晴天，36度呢，怎么阴了！"
      },
      {
        "speaker": "大龙",
        "hanzi": "好像要下雨了！"
      },
      {
        "speaker": "张丽爸爸",
        "hanzi": "天气预报一点儿也不准。"
      },
      {
        "speaker": "张丽妈妈",
        "hanzi": "夏天的天气常常是这样，一会儿阴，一会儿晴。"
      },
      {
        "speaker": "张丽爸爸",
        "hanzi": "哎呀，外面下大雨啦！"
      },
      {
        "speaker": "张丽妈妈",
        "hanzi": "真糟糕，小丽没带伞！"
      },
      {
        "speaker": "张丽爸爸",
        "hanzi": "大龙，你去哪儿？"
      }
    ]
  },
  "grammar": [
    {
      "id": "modal-le",
      "titleZh": "语气助词“了”",
      "titleEn": "The modal particle “了”",
      "patternZh": "……了",
      "patternEn": "… + 了 (change of situation / new situation)",
      "examples": [
        {
          "hanzi": "天阴了。",
          "pinyin": "Tiān yīn le."
        },
        {
          "hanzi": "秋天了，天气凉了。",
          "pinyin": "Qiūtiān le, tiānqì liáng le."
        }
      ]
    },
    {
      "id": "yao-le",
      "titleZh": "“（就/快）要……了”",
      "titleEn": "The structure “(就/快)要……了”",
      "patternZh": "（就/快）要＋VP＋了",
      "patternEn": "(就/快) + 要 + VP + 了",
      "examples": [
        {
          "hanzi": "好像要下大雨了。",
          "pinyin": "Hǎoxiàng yào xià dàyǔ le."
        },
        {
          "hanzi": "明天我们就要考试了。",
          "pinyin": "Míngtiān wǒmen jiù yào kǎoshì le."
        },
        {
          "hanzi": "快要到圣诞节了。",
          "pinyin": "Kuàiyào dào Shèngdàn Jié le."
        }
      ],
      "notes": [
        "就要……了 can take a temporal noun adverbial; 快要……了 cannot."
      ]
    },
    {
      "id": "yidianr-ye-bu",
      "titleZh": "“一点儿也不……”",
      "titleEn": "The structure “一点儿也不……”",
      "patternZh": "一点儿也不＋Adj/VP",
      "patternEn": "一点儿也不 + Adj/VP (not … at all)",
      "examples": [
        {
          "hanzi": "天气预报一点儿也不准。",
          "pinyin": "Tiānqì yùbào yìdiǎnr yě bù zhǔn."
        },
        {
          "hanzi": "我今天一点儿也不累。",
          "pinyin": "Wǒ jīntiān yìdiǎnr yě bù lèi."
        }
      ]
    }
  ],
