  "taskDemo": {
    "pdfPage": 120,
    "sceneZh": "查理和美善在咖啡厅聊天。",
    "sceneEn": "Charlie and Meishan are chatting in a café.",
    "lines": [
      {
        "speaker": "查理",
        "hanzi": "你去过西安吗？"
      },
      {
        "speaker": "美善",
        "hanzi": "去过，那儿有很多名胜古迹，是个旅行的好地方！"
      },
      {
        "speaker": "查理",
        "hanzi": "西安有什么特产？"
      },
      {
        "speaker": "美善",
        "hanzi": "那儿的小吃很有特色。"
      },
      {
        "speaker": "查理",
        "hanzi": "对了，你看兵马俑了吗？"
      },
      {
        "speaker": "美善",
        "hanzi": "当然看了。我觉得，没看过兵马俑等于没去过西安。"
      },
      {
        "speaker": "查理",
        "hanzi": "除了兵马俑以外，西安还有什么好玩儿的地方？"
      },
      {
        "speaker": "美善",
        "hanzi": "那儿的华清池和大雁塔也很有名，可惜我都没去，以后有机会我一定去。"
      },
      {
        "speaker": "查理",
        "hanzi": "这个周末去，怎么样？我请你当我的导游。"
      }
    ]
  },
  "grammar": [
    {
      "id": "aspect-guo",
      "titleZh": "动态助词“过”",
      "titleEn": "The aspect particle “过”",
      "patternZh": "动词＋过",
      "patternEn": "verb + 过",
      "examples": [
        {
          "hanzi": "我去过西安。",
          "pinyin": "Wǒ qùguo Xī'ān."
        },
        {
          "hanzi": "他没吃过烤鸭。",
          "pinyin": "Tā méi chīguo kǎoyā."
        }
      ],
      "notes": [
        "Put after a verb to indicate a past experience.",
        "Often used to highlight having had such an experience."
      ]
    },
    {
      "id": "chule-yiwai",
      "titleZh": "“除了……（以外）”",
      "titleEn": "The structure “除了……（以外）”",
      "patternZh": "除了……（以外），……还/也…… / 都……",
      "patternEn": "Besides/except …, … also/all …",
      "examples": [
        {
          "hanzi": "除了兵马俑以外，西安还有什么好玩儿的地方？"
        },
        {
          "hanzi": "除了看书以外，我也喜欢看电影。"
        },
        {
          "hanzi": "除了大龙以外，他的家人都没来过中国。"
        },
        {
          "hanzi": "除了看书以外，他都不喜欢。"
        }
      ],
      "notes": [
        "Addition: often paired with 还/也.",
        "Exclusion: the mentioned person/thing is not included."
      ]
    },
    {
      "id": "pivotal-sentence",
      "titleZh": "兼语句",
      "titleEn": "The pivotal sentence",
      "patternZh": "主语＋请/让/叫＋兼语＋动词短语",
      "patternEn": "Subject + 请/让/叫 + pivot + VP",
      "examples": [
        {
          "hanzi": "我想请你当我的导游。"
        },
        {
          "hanzi": "我们叫她王老师。"
        }
      ],
      "notes": [
        "The object of the first verb is also the subject of the second verb.",
        "Common causative verbs: 请, 让, 叫."
      ]
    }
  ],
