    "keySentences": [
      {
        "hanzi": "师傅，半个小时到得了吗？",
        "pinyin": "Shīfu, bàn ge xiǎoshí dào de liǎo ma?"
      },
      {
        "hanzi": "现在路上堵车，估计至少得一个半小时。",
        "pinyin": "Xiànzài lùshang dǔchē, gūjì zhìshǎo děi yí ge bàn xiǎoshí."
      },
      {
        "hanzi": "您知道从如家宾馆去大雁塔坐公共汽车怎么走吗？",
        "pinyin": "Nín zhīdào cóng Rújiā Bīnguǎn qù Dàyàntǎ zuò gōnggòng qìchē zěnme zǒu ma?"
      },
      {
        "hanzi": "先坐707路车，到五路口站，然后换41路车到大雁塔站下车。",
        "pinyin": "Xiān zuò 707 lù chē, dào Wǔlùkǒu zhàn, ránhòu huàn 41 lù chē dào Dàyàntǎ zhàn xià chē."
      },
      {
        "hanzi": "麻烦您停一下儿。",
        "pinyin": "Máfan nín tíng yíxiàr."
      }
    ],
    "grammarPoints": [
      {
        "zh": "可能补语",
        "en": "Complement of possibility"
      },
      {
        "zh": "动词“了（liǎo）”做可能补语",
        "en": "The verb “了 (liǎo)” used as a complement of possibility"
      },
      {
        "zh": "动词＋一下儿",
        "en": "V + 一下儿"
      }
    ]
  },
  "taskDemo": {
    "pdfPage": 144,
    "sceneZh": "查理和美善一起来西安旅行，他们坐出租车从西安机场去如家宾馆。",
    "sceneEn": "Charlie and Meishan are travelling together to Xi'an. They are going to Rujia Hotel from Xi'an Airport by taxi.",
    "lines": [
      {
        "speaker": "司机",
        "hanzi": "你们好，你们要去哪儿？"
      },
      {
        "speaker": "查理",
        "hanzi": "您好，师傅，我们去东大街上的如家宾馆。"
      },
      {
        "speaker": "美善",
        "hanzi": "师傅，半个小时到得了吗？"
      },
      {
        "speaker": "司机",
        "hanzi": "半个小时到不了。现在路上堵车，估计至少得一个半小时。"
      },
      {
        "speaker": "查理",
        "hanzi": "啊？早知道我应该订一个近一点儿的宾馆。"
      },
      {
        "speaker": "司机",
        "hanzi": "你们是来旅行的吧？打算去哪儿玩儿啊？"
      },
      {
        "speaker": "查理",
        "hanzi": "我们打算去大雁塔、兵马俑还有古城墙。"
      },
      {
        "speaker": "美善",
        "hanzi": "对了，师傅，您知道从如家宾馆去大雁塔坐公共汽车怎么走吗？"
      },
      {
        "speaker": "司机",
        "hanzi": "先坐707路车，到五路口站，然后换41路车到大雁塔站下车。宾馆门口就有车站，很方便。"
      },
      {
        "speaker": "美善",
        "hanzi": "太好了，谢谢您。"
      },
      {
        "speaker": "查理",
        "hanzi": "不好意思，师傅，麻烦您停一下儿，我想去厕所。"
      },
      {
        "speaker": "司机",
        "hanzi": "我给您到路口调个头，那儿有个公共厕所。"
      }
    ]
  },
  "grammar": [
    {
      "id": "potential-complement",
      "titleZh": "可能补语",
      "titleEn": "Complement of possibility",
      "patternZh": "动词＋得/不＋结果补语/趋向补语",
      "patternEn": "V + 得/不 + complement of result / direction",
      "examples": [
        {
          "hanzi": "今天的作业很多，我一个小时做不完。",
          "pinyin": "Jīntiān de zuòyè hěn duō, wǒ yí ge xiǎoshí zuò bu wán."
        },
        {
          "hanzi": "这座山不太高，我上得去。",
          "pinyin": "Zhè zuò shān bú tài gāo, wǒ shàng de qù."
        }
      ],
      "notes": [
        "Affirmative uses 得 between verb and complement; negative replaces 得 with 不."
      ]
    },
    {
      "id": "liao-potential",
      "titleZh": "动词“了（liǎo）”做可能补语",
      "titleEn": "The verb “了 (liǎo)” used as a complement of possibility",
      "patternZh": "动词＋得/不＋了",
      "patternEn": "V + 得/不 + 了 (liǎo)",
      "examples": [
        {
          "hanzi": "明天是我的生日晚会，你去得了吗？",
          "pinyin": "Míngtiān shì wǒ de shēngrì wǎnhuì, nǐ qù de liǎo ma?"
        },
        {
          "hanzi": "这么多饮料，我一个人喝不了。",
          "pinyin": "Zhème duō yǐnliào, wǒ yí ge rén hē bu liǎo."
        },
        {
          "hanzi": "半个小时到得了吗？",
          "note": "from task demo / key sentences"
        },
        {
          "hanzi": "半个小时到不了。",
          "note": "from task demo"
        }
      ],
      "notes": [
        "Indicates possibility of realizing an action.",
        "Sometimes 了 (liǎo) means 完 (finish)."
      ]
    },
    {
      "id": "yixiar",
      "titleZh": "动词＋一下儿",
      "titleEn": "V + 一下儿",
      "patternZh": "动词＋一下儿",
      "patternEn": "verb + 一下儿",
      "examples": [
        {
          "hanzi": "我来介绍一下儿。"
        },
        {
          "hanzi": "麻烦您，我想问一下儿。"
        },
        {
          "hanzi": "麻烦您停一下儿。",
          "note": "from key sentences / task demo"
        }
      ],
      "notes": [
        "Indicates the action is brief or done casually/lightly."
      ]
    }
  ],
