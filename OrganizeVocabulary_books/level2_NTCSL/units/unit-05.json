  "taskDemo": {
    "pdfPage": 100,
    "sceneZh": "大卫和大龙在教室里谈论昨晚的足球赛。",
    "sceneEn": "David and Dalong are in the classroom talking about the football match last night.",
    "lines": [
      {
        "speaker": "大龙",
        "hanzi": "昨天的比赛你看了吗？"
      },
      {
        "speaker": "大卫",
        "hanzi": "当然看了，昨天晚上看到两点。"
      },
      {
        "speaker": "大龙",
        "hanzi": "谁赢了？"
      },
      {
        "speaker": "大卫",
        "hanzi": "你没看吗？"
      },
      {
        "speaker": "大龙",
        "hanzi": "别提了，我昨天一边喝啤酒，一边看比赛，可是还没看完就喝醉了。"
      },
      {
        "speaker": "大卫",
        "hanzi": "昨天的比赛特别精彩！阿根廷赢了。"
      },
      {
        "speaker": "大龙",
        "hanzi": "我猜对了，是几比几赢的？"
      },
      {
        "speaker": "大卫",
        "hanzi": "2：0。"
      },
      {
        "speaker": "大龙",
        "hanzi": "谁进的球？"
      },
      {
        "speaker": "大卫",
        "hanzi": "你最喜欢的球星，都是他进的。第二个是个点球。"
      },
      {
        "speaker": "大龙",
        "hanzi": "太可惜了，我只能看重播了。对了，今天的比赛是谁对谁？"
      },
      {
        "speaker": "大卫",
        "hanzi": "韩国对美国。我和艾娜说好了去酒吧看。你去吗？"
      },
      {
        "speaker": "大龙",
        "hanzi": "好啊，我们一起去吧。"
      }
    ]
  },
  "grammar": [
    {
      "id": "result-complement",
      "titleZh": "结果补语",
      "titleEn": "Complement of result",
      "patternZh": "动词＋结果补语（到／完／对／错／好…）",
      "patternEn": "Verb + complement of result (到 / 完 / 对 / 错 / 好…)",
      "examples": [
        {
          "hanzi": "看到十二点",
          "pinyin": "kàndào shí'èr diǎn"
        },
        {
          "hanzi": "找到",
          "pinyin": "zhǎodào"
        },
        {
          "hanzi": "他吃完饭了。",
          "pinyin": "Tā chīwán fàn le."
        },
        {
          "hanzi": "写完作业",
          "pinyin": "xiěwán zuòyè"
        },
        {
          "hanzi": "说对／说错",
          "note": "V+对/错"
        },
        {
          "hanzi": "猜对／猜错",
          "note": "V+对/错"
        },
        {
          "hanzi": "准备好",
          "note": "V+好"
        },
        {
          "hanzi": "修好",
          "note": "V+好"
        },
        {
          "hanzi": "没吃完饭",
          "note": "negation: 没+V+result"
        },
        {
          "hanzi": "没准备好",
          "note": "negation: 没+V+result"
        },
        {
          "hanzi": "做好饭了",
          "note": "object after result complement"
        },
        {
          "hanzi": "找到他了",
          "note": "object after result complement"
        }
      ],
      "notes": [
        "An adjective or verb after the main verb indicates the result of the action.",
        "Negative form is generally 没＋V＋result.",
        "When there is an object, place it after the result complement."
      ]
    },
    {
      "id": "yibian-yibian",
      "titleZh": "“一边……一边……”",
      "titleEn": "The structure “一边……一边……”",
      "patternZh": "一边＋V1，一边＋V2",
      "patternEn": "一边 + V1, 一边 + V2",
      "examples": [
        {
          "hanzi": "他一边喝啤酒，一边看比赛。",
          "pinyin": "Tā yìbiān hē píjiǔ, yìbiān kàn bǐsài."
        },
        {
          "hanzi": "大家一边唱歌，一边跳舞。",
          "pinyin": "Dàjiā yìbiān chànggē, yìbiān tiàowǔ."
        },
        {
          "hanzi": "边走边看",
          "note": "一 may be omitted with monosyllabic verbs"
        }
      ],
      "notes": [
        "Indicates two or more actions happening at the same time.",
        "Generally connects concrete-action verbs such as 走路、看书.",
        "With monosyllabic verbs like 走/听/说/看/想, 一 can be omitted (边走边看)."
      ]
    }
  ],
