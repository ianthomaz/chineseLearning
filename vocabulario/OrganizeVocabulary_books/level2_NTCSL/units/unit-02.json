    "keySentences": [
      {
        "hanzi": "我有点儿发烧，嗓子也疼得很厉害。",
        "pinyin": "Wǒ yǒudiǎnr fā shāo, sǎngzi yě téng de hěn lìhai."
      },
      {
        "hanzi": "什么时候开始的？",
        "pinyin": "Shénme shíhou kāishǐ de?"
      },
      {
        "hanzi": "你去医院了吗？",
        "pinyin": "Nǐ qù yīyuàn le ma?"
      },
      {
        "hanzi": "这是医生给我开的药，一天三次，一次两片。",
        "pinyin": "Zhè shì yīshēng gěi wǒ kāi de yào, yì tiān sān cì, yí cì liǎng piàn."
      },
      {
        "hanzi": "你要多喝水，按时吃药，好好儿休息。",
        "pinyin": "Nǐ yào duō hē shuǐ, ànshí chī yào, hǎohāor xiūxi."
      }
    ],
    "grammarPoints": [
      {
        "zh": "表完成的“了”",
        "en": "“了” indicating completion"
      },
      {
        "zh": "“是……的”",
        "en": "The structure “是……的”"
      }
    ]
  },
  "taskDemo": {
    "pdfPage": 42,
    "sceneZh": "张丽和大龙在家聊天。",
    "sceneEn": "Zhang Li and Dalong are chatting at home.",
    "lines": [
      {
        "speaker": "张丽",
        "hanzi": "大龙，你怎么没去上课？"
      },
      {
        "speaker": "大龙",
        "hanzi": "我有点儿发烧，嗓子也疼得很厉害。"
      },
      {
        "speaker": "张丽",
        "hanzi": "什么时候开始的？"
      },
      {
        "speaker": "大龙",
        "hanzi": "今天早上。"
      },
      {
        "speaker": "张丽",
        "hanzi": "一定是昨天给我送伞时着凉了。你去医院了吗？我陪你去吧。"
      },
      {
        "speaker": "大龙",
        "hanzi": "去了，这是医生给我开的药，可是我没看明白怎么吃。"
      },
      {
        "speaker": "张丽",
        "hanzi": "我看看，一天三次，一次两片。你要多喝水，按时吃药，好好儿休息。"
      }
    ]
  },
  "grammar": [
    {
      "id": "completion-le",
      "titleZh": "表完成的“了”",
      "titleEn": "“了” indicating completion",
      "patternZh": "……了 / 没（有）＋VP",
      "patternEn": "… + 了; negative: 没(有) + VP (no final 了)",
      "examples": [
        {
          "hanzi": "我去医院了。",
          "pinyin": "Wǒ qù yīyuàn le."
        },
        {
          "hanzi": "你今天怎么没去上课？",
          "pinyin": "Nǐ jīntiān zěnme méi qù shàng kè?"
        }
      ]
    },
    {
      "id": "shi-de",
      "titleZh": "“是……的”",
      "titleEn": "The structure “是……的”",
      "patternZh": "是＋相关信息＋的",
      "patternEn": "是 + related info (time/place/manner/…) + 的",
      "examples": [
        {
          "hanzi": "我是从昨天开始发烧的。",
          "pinyin": "Wǒ shì cóng zuótiān kāishǐ fā shāo de."
        },
        {
          "hanzi": "她是从美国来的。",
          "pinyin": "Tā shì cóng Měiguó lái de."
        },
        {
          "hanzi": "他是走路来的。",
          "pinyin": "Tā shì zǒulù lái de."
        },
        {
          "hanzi": "你什么时候来的？",
          "pinyin": "Nǐ shénme shíhou lái de?",
          "note": "是 may be omitted"
        },
        {
          "hanzi": "他不是坐飞机来的。",
          "pinyin": "Tā bú shì zuò fēijī lái de."
        }
      ],
      "notes": [
        "Used for already-occurred actions to highlight time, place, manner, etc.",
        "Negative form: 不是……的."
      ]
    }
  ],
