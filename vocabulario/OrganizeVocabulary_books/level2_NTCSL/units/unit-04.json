    "keySentences": [
      {
        "hanzi": "酒吧在哪儿？",
        "pinyin": "Jiǔbā zài nǎr?"
      },
      {
        "hanzi": "还是我自己去吧。",
        "pinyin": "Háishì wǒ zìjǐ qù ba."
      },
      {
        "hanzi": "去酒吧怎么走？",
        "pinyin": "Qù jiǔbā zěnme zǒu?"
      },
      {
        "hanzi": "一直往前走，到第二个十字路口往右拐。",
        "pinyin": "Yìzhí wǎng qián zǒu, dào dì èr ge shízì lùkǒu wǎng yòu guǎi."
      },
      {
        "hanzi": "酒吧就在马路左边。",
        "pinyin": "Jiǔbā jiù zài mǎlù zuǒbiān."
      },
      {
        "hanzi": "酒吧离这儿远不远？",
        "pinyin": "Jiǔbā lí zhèr yuǎn bu yuǎn?"
      }
    ],
    "grammarPoints": [
      {
        "zh": "方位的表达",
        "en": "The expressions of locations"
      },
      {
        "zh": "“还是……吧”",
        "en": "The structure “还是……吧”"
      }
    ]
  },
  "taskDemo": {
    "pdfPage": 81,
    "sceneZh": "大龙已经到酒吧了，艾娜在路上给大龙打电话。",
    "sceneEn": "Dalong has arrived at the bar; Edna is calling him on her way.",
    "lines": [
      {
        "speaker": "艾娜",
        "hanzi": "大龙，酒吧在哪儿？我找了半天也没找到。"
      },
      {
        "speaker": "大龙",
        "hanzi": "你现在在哪儿？我去接你吧。"
      },
      {
        "speaker": "艾娜",
        "hanzi": "不用，还是我自己去吧。我在天天超市门口，去酒吧怎么走？"
      },
      {
        "speaker": "大龙",
        "hanzi": "一直往前走，到第二个十字路口往右拐。酒吧就在马路左边。"
      },
      {
        "speaker": "艾娜",
        "hanzi": "离这儿远不远？"
      },
      {
        "speaker": "大龙",
        "hanzi": "不远，走路10分钟就能到。"
      },
      {
        "speaker": "艾娜",
        "hanzi": "大龙，马路左边是个饭店，不是酒吧啊？"
      },
      {
        "speaker": "大龙",
        "hanzi": "啊？你是不是走错了？"
      },
      {
        "speaker": "艾娜",
        "hanzi": "我从超市南门一直往前走……"
      },
      {
        "speaker": "大龙",
        "hanzi": "啊，对不起，我没问明白，我以为你在北门呢。"
      },
      {
        "speaker": "艾娜",
        "hanzi": "那怎么办？现在我还要走20多分钟才能到那儿。"
      }
    ]
  },
  "grammar": [
    {
      "id": "location-expressions",
      "titleZh": "方位的表达",
      "titleEn": "The expressions of locations",
      "patternZh": "A＋在＋B＋方位词",
      "patternEn": "A + 在 + B + word of locality",
      "examples": [
        {
          "hanzi": "地铁站在马路左边。",
          "pinyin": "Dìtiězhàn zài mǎlù zuǒbiān."
        },
        {
          "hanzi": "我在他前边。",
          "pinyin": "Wǒ zài tā qiánbiān."
        },
        {
          "hanzi": "银行在超市西边。",
          "pinyin": "Yínháng zài chāoshì xībiān."
        }
      ],
      "notes": [
        "方位词 include 前边、后边、左边、右边、东边、南边、西边、北边, etc.",
        "在 introduces the locality or place where something is located."
      ]
    },
    {
      "id": "haishi-ba",
      "titleZh": "“还是……吧”",
      "titleEn": "The structure “还是……吧”",
      "patternZh": "还是＋建议＋吧",
      "patternEn": "还是 + suggestion + 吧",
      "examples": [
        {
          "hanzi": "坐飞机太贵了，我们还是坐火车去吧。",
          "pinyin": "Zuò fēijī tài guì le, wǒmen háishì zuò huǒchē qù ba."
        },
        {
          "hanzi": "星期天人太多了，我们还是星期五去吧。",
          "pinyin": "Xīngqītiān rén tài duō le, wǒmen háishì xīngqī wǔ qù ba."
        },
        {
          "hanzi": "不用，还是我自己去吧。",
          "note": "from task demo"
        }
      ],
      "notes": [
        "还是 is an adverb indicating a relatively satisfactory choice after comparison."
      ]
    }
  ],
